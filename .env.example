DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
FLASK_ENV=production
API_KEY=your-secret-api-key-here

# Embeddings RAG — SEMPRE OpenAI real (1536 dims fixos no DB, Gemini key não funciona)
EMBEDDINGS_API_KEY=sk-...
# LLM calls (opcional) — pode ser Gemini compat layer ou OpenAI
# Se vazio, usa OPENAI_API_KEY. NÃO afeta embeddings.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# ATENÇÃO: 0.7 é o default do código e ELIMINA todos os resultados com
# text-embedding-3-small. STG e PRD rodam 0.4 (ambos), e o valor não é cosmético:
# a 0.5 as perguntas mais comuns do MEI ("quando vence o DAS", "DAS atrasado")
# voltam ZERO chunks, sem ganho de precisão medido (vazamento é 0,0% nos dois).
# Recall medido a 0.4: 0,92 — idêntico em pgvector e Upstash.
RAG_MATCH_THRESHOLD=0.4
RAG_MATCH_COUNT=5

# Backend de busca vetorial: pgvector (default) = tabela documents no Supabase;
# upstash = índice Upstash Vector com namespace por perfil (mei|pl|autonomo).
# A/B de 2026-08-17: recall idêntico (0,92) nos dois, zero divergência em 31 casos.
# Lido no import — mudar exige RESTART do container, não só salvar.
# Qualquer valor diferente de "upstash" cai no pgvector EM SILÊNCIO; o sinal de que
# a flag pegou é a linha "[rag] upstash ok: perfil=X resultados=N" no stdout.
RAG_BACKEND=pgvector
# Produto DIFERENTE do Upstash Redis acima — outro índice, outro token.
# Free tier permite 1 índice só: STG e PRD COMPARTILHAM o vector store.
# Vazio com RAG_BACKEND=upstash = degrada para pgvector e loga.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# TypeSafe/Jev — filtro de passagens RAG (lab). Default off.
# Com TYPESAFE_RAG_SCORE=1 + key: cada chunk do topK ganha Nouls
# (relevante / evidencia / injecao); código dropa lixo antes do LLM Dúvidas.
# Fail-open: sem key, flag 0 ou erro API → topK embedding intacto.
# NÃO ligar em prod até smoke lab/STG. Detalhe: meirelles-dev/docs/plano-typesafe-rag-score.md
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_RAG_SCORE=0
TYPESAFE_RAG_RELEVANT_MIN=0.45
TYPESAFE_RAG_EVIDENCE_MIN=0.55
TYPESAFE_RAG_INJECTION_MAX=0.70

# Discord Incoming Webhook (ops). Vazio = desligado.
# Em prod: copiar o mesmo URL do n8n `N8N_ERROR_WEBHOOK_URL` (Easypanel).
# NÃO versionar o valor real.
DISCORD_ALERT_WEBHOOK_URL=

# Cache L2 distribuído — Upstash Redis (REST). Vazio = desativado (no-op, fail-open).
# Uma DB free serve STG+PRD via prefixo de chave.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_ENV_PREFIX=          # stg | prd (isola chaves na DB compartilhada)
REDIS_TTL_USER=600         # contexto usuário (curto; Postgres é lei)
REDIS_TTL_RAG=3600         # resultado busca vetorial (corta custo embeddings)
REDIS_TTL_MEMORIA=43200    # janela quente chat_memory (12h)
DEDUP_TTL=60               # janela de deduplicação de mensagem
RATE_LIMIT_MAX=30          # requests por janela
RATE_LIMIT_WINDOW=60       # janela do rate-limit (segundos)

# Cache TTLs (segundos)
CACHE_TTL_USUARIO=60
CACHE_TTL_SALDO=300
CACHE_TTL_COMPROVANTES=300
CACHE_TTL_AGENDAMENTOS=120
CACHE_TTL_LISTAS=300
CACHE_TTL_PERSONA=3600
CACHE_TTL_MEMORIA=60
